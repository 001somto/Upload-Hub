# Copy this file to ".env" (same folder) and change the value if your backend runs somewhere else.
# Vite only exposes variables that start with VITE_ to the website.
# Never put passwords, AWS keys or other secrets in this file: it is visible to everyone who opens the site.

# The address of the backend API (the Express server in the "backend" folder).
VITE_API_BASE_URL=http://localhost:4000
