# .env.example
# WHAT THIS FILE IS: a list of the settings the backend needs, with safe example values.
# HOW TO USE IT: copy this file to a new file called ".env" (same folder) and fill it in.
# NEVER commit ".env" - it holds secrets. This example file is safe to commit.

# Port the backend listens on.
PORT=4000

# "development" or "production". Production turns off developer conveniences.
NODE_ENV=development

# Secret used to sign sign-in tokens. REQUIRED. Use a long random value (32+ characters).
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars

# How many hours a sign-in lasts.
SESSION_HOURS=8

# Website addresses allowed to call this backend (comma separated).
CORS_ORIGINS=http://localhost:5173

# The website address, used inside password-reset links.
FRONTEND_URL=http://localhost:5173

# --- DynamoDB ---
# AWS region. For DynamoDB Local any value works.
AWS_REGION=eu-west-1
# Leave this set to use DynamoDB Local (started with Docker or the jar, see README).
# Remove this line to use the real AWS DynamoDB (the teammate configures AWS).
DYNAMODB_ENDPOINT=http://localhost:8000
# Table names (the teammate may rename these when the final database design is agreed).
USERS_TABLE=UploadHub_Users
RESET_TOKENS_TABLE=UploadHub_PasswordResets

# "memory" keeps everything in RAM (lost on restart) - only for quick tries.
# "dynamo" uses DynamoDB. Default is dynamo.
STORAGE_MODE=dynamo

# --- Email ---
# "console" prints reset links in this terminal (development only).
# "none" sends nothing. Real sending (AWS SES) is added by the teammate.
EMAIL_MODE=console

# Only used by "npm run seed-admin" (development helper, refuses to run in production).
SEED_ADMIN_NAME=Dev Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123
